# Linux 6.12.27 on top of tinyconfig (issue #36, docs/rv32-linux.md). build.sh merges this into
# allnoconfig with tiny.config and saves the result as /build/gen/linux.config.
# M-mode nommu RV32IMA: no C, no FPU (F alone; Linux needs D), one hart.
CONFIG_ARCH_RV32I=y
# CONFIG_MMU is not set
CONFIG_NONPORTABLE=y
CONFIG_RISCV_M_MODE=y
# CONFIG_SMP is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
CONFIG_HZ_100=y
CONFIG_PRINTK=y
# CONFIG_PRINTK_TIME is not set
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_CMDLINE="earlycon=uart8250,mmio,0x10000000 console=ttyS0"
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_SOURCE="tiny-processors"
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
