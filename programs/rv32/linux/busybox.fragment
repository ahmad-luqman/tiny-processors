# busybox 1.37.0 (issue #36): allnoconfig plus these, written as /build/gen/busybox.config by build.sh.
# hush is the shell: ash needs fork, which nommu lacks. LFS matches Buildroot's 64-bit off_t.
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LONG_OPTS=y
CONFIG_NOMMU=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_HUSH=y
CONFIG_SH_IS_HUSH=y
CONFIG_SHELL_HUSH=y
CONFIG_HUSH_BASH_COMPAT=y
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_JOB=y
CONFIG_HUSH_TICK=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_FUNCTIONS=y
CONFIG_HUSH_LOCAL=y
CONFIG_HUSH_EXPORT=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_UNSET=y
CONFIG_HUSH_ECHO=y
CONFIG_HUSH_PRINTF=y
CONFIG_HUSH_TEST=y
CONFIG_HUSH_TRAP=y
CONFIG_HUSH_TYPE=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_EDITING=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_UNAME=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_MKDIR=y
CONFIG_HEAD=y
CONFIG_WC=y
CONFIG_SLEEP=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_DMESG=y
CONFIG_FREE=y
CONFIG_PS=y
CONFIG_UPTIME=y
CONFIG_KILL=y
CONFIG_LN=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_GREP=y
CONFIG_SEQ=y
CONFIG_EXPR=y
CONFIG_DATE=y
CONFIG_HOSTNAME=y
CONFIG_MDEV=y
CONFIG_LFS=y
CONFIG_HUSH_UMASK=y
